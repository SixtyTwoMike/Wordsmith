# Wordsmith — static PWA served by Caddy with automatic HTTPS.
# {$DEPLOY_DOMAIN} is supplied by the environment when Caddy starts
# (setup-server.sh writes it into the systemd unit). Caddy fetches and
# renews a Let's Encrypt certificate for that hostname automatically.

{$DEPLOY_DOMAIN} {
	root * /var/www/wordsmith
	encode gzip

	# Correct content types the app depends on.
	@manifest path *.webmanifest
	header @manifest Content-Type application/manifest+json
	@mjs path *.mjs
	header @mjs Content-Type text/javascript

	# The service worker must always revalidate so updates roll out.
	@sw path /sw.js
	header @sw Cache-Control "no-cache"

	file_server

	# Single-page fallback: unknown paths return the app shell.
	try_files {path} /index.html
}
